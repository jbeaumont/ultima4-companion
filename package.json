{
  "name": "ultima4-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop companion for Ultima IV: Quest of the Avatar",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
