    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "koffi": "^2.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
